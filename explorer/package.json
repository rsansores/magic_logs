{
  "name": "magic_logs_explorer",
  "version": "0.1.0",
  "description": "The magic_logs explorer for Vue 3, without its looks: a window of time, facets with counts, a histogram that zooms, the rows newest first and grouped counts — state in your URL, drawn by your design system.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/rsansores/magic_logs/tree/main/explorer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsansores/magic_logs.git",
    "directory": "explorer"
  },
  "bugs": {
    "url": "https://github.com/rsansores/magic_logs/issues"
  },
  "keywords": [
    "logs",
    "explorer",
    "timescaledb",
    "histogram",
    "facets",
    "headless",
    "vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.5.0",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "module": "./dist/explorer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/explorer.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host --port 5198",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/finish-build.js",
    "check:pack": "pnpm run build && publint --strict --pack pnpm && attw --pack . --profile esm-only",
    "prepack": "cp ../LICENSE-MIT ../LICENSE-APACHE . && pnpm run build",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,vue}\" \"demo/**/*.{ts,vue}\" \"scripts/*.js\"",
    "format": "prettier --write \"src/**/*.{ts,vue,json}\" \"demo/**/*.{ts,vue,css}\" \"scripts/*.js\" \"*.{json,js,ts,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json}\" \"demo/**/*.{ts,vue,css}\" \"scripts/*.js\" \"*.{json,js,ts,md}\"",
    "knip": "knip",
    "screenshot": "node scripts/screenshot.js"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
